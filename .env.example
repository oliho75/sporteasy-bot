# Copie ce fichier en .env. Ne partage jamais ce fichier.
# Un bloc par compte (USER1, USER2, USER3…). Chaque compte a son URL /u/<NAME>/?token=<TOKEN>
USER1_NAME=ao
USER1_EMAIL=
USER1_PASSWORD=
USER1_TOKEN=          # openssl rand -hex 24 (vide = pas de protection, OK en local uniquement)
#USER2_NAME=pote1
#USER2_EMAIL=
#USER2_PASSWORD=
#USER2_TOKEN=

# Club (SitéBad) — déjà rempli
SPORTEASY_TEAM_ID=2050454
SPORTEASY_TEAM_HOST=sitebad.sporteasy.net

# Comportement
PORT=8765
TICK_SECONDS=30          # poll normal
HOT_WINDOW_SECONDS=120   # mode rapide X secondes avant l'ouverture
HOT_INTERVAL_SECONDS=1.5 # fréquence de poll en mode rapide
HOT_MAX_MINUTES=20       # abandon du mode rapide si ça n'ouvre pas (repris au tick suivant)
MAX_PER_WEEK=5

# Optionnel : webhook Slack/Discord-compatible pour les notifs (sinon notif macOS)
NOTIFY_WEBHOOK=
